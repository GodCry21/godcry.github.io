{
  "name": "Bety&Kuba",
  "short_name": "Bety&Kuba",

  "id": "/",
  "start_url": "/",
  "scope": "/",

  "launch_handler": {
    "client_mode": "navigate-existing"
  },

  "icons": [
    {
      "src": "/my-favicon/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/my-favicon/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "theme_color": "#ffcb96",
  "background_color": "#a6b8a3",
  "display": "standalone"
}